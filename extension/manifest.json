{
  "manifest_version": 3,
  "name": "Repository Intelligence Platform (RIP)",
  "version": "1.0.0",
  "description": "Cross-browser AI assistant forecasting GitHub repository growth, maintainability, and abandonment risk.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://github.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_end"
    }
  ]
}
